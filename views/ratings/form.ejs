<%- include('../partials/head') %>
<%
  const v = values || {};
  const isEdit = mode === 'edit';
  const val = (k) => (v[k] === undefined || v[k] === null ? '' : v[k]);
  const has = (k, item) => { const x = v[k]; return Array.isArray(x) ? x.includes(item) : x === item; };
  const posName = { F: 'Forward', D: 'Defense', G: 'Goaltender' };
  const action = isEdit ? `/admin/ratings/${rating.id}` : `/players/${player.id}/rate`;
%>
<p class="crumbs"><a href="/players/<%= player.id %>">← <%= player.first_name %> <%= player.last_name %></a></p>

<section class="card form-hero">
  <h1><%= isEdit ? 'Edit rating' : 'Player rating form' %></h1>
  <p class="muted small">Season: <strong><%= isEdit ? rating.season_name : season.name %></strong></p>
  <p class="hero-player"><strong><%= player.first_name %> <%= player.last_name %></strong>
    <span class="muted"><%= [player.jersey_number ? `#${player.jersey_number}` : null, player.team, player.division, posName[player.position], ageOf(player) ? `Age ${ageOf(player)}` : null].filter(Boolean).join(' · ') %></span></p>
  <% if (isEdit) { %>
    <div class="alert alert-info">You are editing <strong><%= rating.rater_name %></strong>'s rating as an admin. Changes are recorded in the audit log.</div>
  <% } %>
  <details class="guidelines">
    <summary>Rater guidelines — <em>rate what you see, not what you think</em></summary>
    <ul>
      <li>Rate what the player <strong>consistently demonstrates</strong>, especially during actual game situations.</li>
      <li>Consider both offensive and defensive play, at game speed and under pressure.</li>
      <li>Don't give significant extra credit for one exceptional play, or heavily penalize one mistake.</li>
      <li>Don't rate based on reputation, what others say, age, size or potential.</li>
      <li>An injury should only affect the rating if it materially limits what the player can currently demonstrate.</li>
      <li>Complete your evaluation independently before discussing the player with other raters.</li>
    </ul>
    <p><strong>The key question:</strong> What level does this player consistently demonstrate during actual game play?</p>
    <p>For each category pick the level the player shows, then <strong>Low</strong>, <strong>Medium</strong> or <strong>High</strong> within it. Beginner and A are a single choice.</p>
  </details>
</section>

<%- include('../partials/errors') %>

<form method="post" action="<%= action %>" class="rating-form" id="rating-form" novalidate
      data-weights='<%= JSON.stringify(categories.map(c => ({ id: c.id, w: Number(c.weight) }))) %>'
      data-bounds='<%= JSON.stringify(levels.BOUNDS.map(b => ({ level: b.level, tier: b.tier, upper: b.upper === Infinity ? null : b.upper }))) %>'>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (!isEdit) { %><input type="hidden" name="season_id" value="<%= season.id %>"><% } %>
  <% if (isEdit && rating.legacy) { %>
    <div class="alert alert-info">This rating was made on the old 0–11 scale (old scores: <%= categories.map(c => `${c.name} ${rating.scoreMap[c.id] ? rating.scoreMap[c.id].score : '—'}`).join(', ') %>). Saving re-scores it on the new scale so it counts toward averages again.</div>
  <% } %>

  <% categories.forEach(function (c, idx) { const cur = String(val(`score_${c.id}`)); %>
  <fieldset class="card category" id="cat-<%= c.id %>">
    <legend class="category-title"><span class="cat-num"><%= idx + 1 %></span> <%= c.name %> <span class="weight"><%= Number(c.weight) %>%</span></legend>
    <% if (c.note) { %><p class="cat-note"><%= c.note %></p><% } %>
    <% if (c.key_question) { %><p class="key-question"><strong>Key question:</strong> <%= c.key_question %></p><% } %>
    <% if (c.considerations.length || c.guide.length) { %>
    <details class="cat-guide">
      <summary>What to consider &amp; rating guide</summary>
      <% if (c.considerations.length) { %>
        <ul class="considerations"><% c.considerations.forEach(function (x) { %><li><%= x %></li><% }) %></ul>
      <% } %>
      <% if (c.guide.length) { %>
        <dl class="guide"><% c.guide.forEach(function (g) { %>
          <dt><%= g.label %></dt><dd><%= g.text %></dd>
        <% }) %></dl>
      <% } %>
    </details>
    <% } %>
    <div class="grade-scale" role="radiogroup" aria-label="<%= c.name %> level">
      <% levels.BANDS.forEach(function (b) { const steps = Object.keys(b.points); %>
        <div class="grade-col">
          <span class="grade-head" title="<%= b.name || b.level %>"><%= b.level %></span>
          <% steps.forEach(function (st) { const key = st ? `${b.level}:${st}` : b.level; %>
            <label class="grade grade-<%= b.tier %> grade-step-<%= st || 'one' %>">
              <input type="radio" name="score_<%= c.id %>" value="<%= key %>" data-points="<%= b.points[st] %>" <%= cur === key ? 'checked' : '' %> required
                     aria-label="<%= st ? `${b.level} ${levels.STEP_NAMES[st]}` : (b.name || b.level) %>">
              <% if (st) { %><span><span class="long"><%= levels.STEP_NAMES[st] %></span><span class="short"><%= levels.STEP_SHORT[st] %></span></span><% } else { %><span>Select</span><% } %>
            </label>
          <% }) %>
        </div>
      <% }) %>
    </div>
    <label class="comment-label">Comments <small class="muted">(optional)</small>
      <textarea name="comment_<%= c.id %>" rows="2" maxlength="2000"><%= val(`comment_${c.id}`) %></textarea></label>
  </fieldset>
  <% }) %>

  <section class="card">
    <h2>Overall score</h2>
    <p class="calc">Calculated overall: <strong id="calc-score">—</strong> / <%= levels.MAX_POINTS %> → <span id="calc-level" class="level level-none">—</span></p>
    <p class="small muted">Overall = <%= categories.map(c => `${c.name} × ${(Number(c.weight) / 100).toFixed(2)}`).join(' + ') %>, using the points for each choice (Beginner 0 up to A 15).</p>
  </section>

  <section class="card">
    <h2><label for="evidence">Observation notes</label></h2>
    <p class="small muted">What you saw: strengths and limitations, rather than simply "good" or "bad". E.g. "Strong forward skating and puck protection. Good passing. Backward skating and defensive positioning are weaker."</p>
    <textarea id="evidence" name="evidence" rows="4" maxlength="4000"><%= val('evidence') %></textarea>
  </section>

  <fieldset class="card final">
    <legend><h2>Rater recommendation</h2></legend>
    <p>What level do you recommend for this player? <span class="small muted">This doesn't change the score; admins review it alongside the ratings.</span></p>
    <div class="level-picker" role="radiogroup" aria-label="Rater recommendation">
      <% levels.LEVELS.forEach(function (l) { %>
        <label class="chip level-chip level-<%= levels.levelTier(l) %>"><input type="radio" name="final_level" value="<%= l %>" <%= has('final_level', l) ? 'checked' : '' %>><span><%= l %></span></label>
      <% }) %>
    </div>
    <% if (isEdit) { %>
      <label>Reason for admin change <small class="muted">(recorded in the audit log)</small>
        <input name="admin_reason" maxlength="1000" value="<%= val('admin_reason') %>"></label>
    <% } %>
  </fieldset>

  <div class="submit-bar">
    <div class="submit-calc"><span class="small muted">Overall</span> <strong id="bar-score">—</strong> <span id="bar-level" class="level level-none">—</span></div>
    <button class="btn btn-primary" type="submit"><%= isEdit ? 'Save changes' : 'Submit rating' %></button>
  </div>
  <% if (!isEdit) { %><p class="small muted center">You can submit one rating per player each season. To change it later, contact an Admin.</p><% } %>
</form>
<%- include('../partials/foot') %>
