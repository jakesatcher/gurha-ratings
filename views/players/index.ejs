<%- include('../partials/head') %>
<p class="crumbs"><a href="/players">Leagues</a> › Search</p>
<div class="page-head">
  <h1>Players</h1>
  <% if (currentUser.role === 'admin') { %><a class="btn btn-small" href="/admin/players/new">+ Add player</a><% } %>
</div>

<form method="get" action="/players" class="filters" role="search">
  <input type="search" name="q" value="<%= filters.q %>" placeholder="Search name, team or jersey #" aria-label="Search players" autocomplete="off" class="search">
  <div class="filter-row">
    <select name="team" aria-label="Team">
      <option value="">All teams</option>
      <% teams.forEach(function (t) { %><option value="<%= t.id %>" <%= filters.team === String(t.id) ? 'selected' : '' %>><%= t.name %><%= t.division ? ` (${t.division})` : '' %></option><% }) %>
    </select>
    <select name="position" aria-label="Position">
      <option value="">All positions</option>
      <option value="F" <%= filters.position === 'F' ? 'selected' : '' %>>Forward</option>
      <option value="D" <%= filters.position === 'D' ? 'selected' : '' %>>Defense</option>
      <option value="G" <%= filters.position === 'G' ? 'selected' : '' %>>Goaltender</option>
    </select>
    <select name="status" aria-label="Status">
      <option value="">Everyone</option>
      <% if (currentUser.canRate) { %>
      <option value="unrated" <%= filters.status === 'unrated' ? 'selected' : '' %>>Not rated by me</option>
      <option value="rated" <%= filters.status === 'rated' ? 'selected' : '' %>>Rated by me</option>
      <% } %>
      <option value="none" <%= filters.status === 'none' ? 'selected' : '' %>>No ratings yet</option>
      <option value="review" <%= filters.status === 'review' ? 'selected' : '' %>>Needs 3rd review</option>
    </select>
    <select name="sort" aria-label="Sort">
      <option value="name">Sort: Name</option>
      <option value="rating" <%= filters.sort === 'rating' ? 'selected' : '' %>>Sort: Rating</option>
    </select>
    <button class="btn" type="submit">Search</button>
  </div>
</form>

<p class="muted small"><%= players.length %> player<%= players.length === 1 ? '' : 's' %></p>

<% if (!players.length) { %>
  <div class="card center"><p>No players found on the <strong><%= season.name %></strong> roster.</p>
    <% if (currentUser.role === 'admin') { %><p><a href="/admin/sportsengine">Import from SportsEngine</a>, <a href="/admin/import">upload a file</a> or <a href="/admin/players/new">add a player</a>.</p><% } %>
  </div>
<% } else { %>
  <ul class="player-list">
    <% players.forEach(function (p, i) { %>
      <%- include('../partials/player-row', { p: p, s: summaries.get(p.id), rated: mine.has(p.id) }) %>
      <% if (i === 7) { %><li class="feed-ad"><%- include('../partials/ad', { slot: 'feed' }) %></li><% } %>
    <% }) %>
  </ul>
<% } %>
<%- include('../partials/foot') %>
