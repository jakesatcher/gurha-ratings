<%- include('../partials/head') %>
<p class="crumbs no-print"><a href="/reports/teams">Teams</a> › <a href="<%= leagueHref %>"><%= team.division || 'No league' %></a> › <%= team.name %></p>
<div class="page-head no-print">
  <h1><%= team.name %> summary</h1>
  <div class="actions">
    <a class="btn btn-small" href="/teams/<%= team.id %>">Players</a>
    <a class="btn btn-small" href="/reports/export.csv?team=<%= team.id %>">Export CSV</a>
    <button class="btn btn-small" type="button" data-print>Print</button>
  </div>
</div>


<% if (team) { %>
<section class="card report">
  <div class="report-head">
    <h2>GURHA Recreational Hockey</h2>
    <p class="report-sub">Team player rating &amp; division summary</p>
    <dl class="dl dl-inline">
      <dt>Date</dt><dd><%= fmtDate(new Date()) %></dd>
      <dt>Season</dt><dd><%= season.name %></dd>
      <dt>Team</dt><dd><%= team.name %></dd>
      <dt>League / Division</dt><dd><%= team.division || '—' %></dd>
    </dl>
    <div class="report-score">
      <%- include('../partials/team-score', { s: score, big: true }) %>
      <span class="small muted"><% if (score.cap === null) { %>No points limit set for this league.<% } else if (score.over > 0) { %><%= fmt(score.over) %> points over the <%= fmt(score.cap) %> cap.<% } else { %><%= fmt(-score.over) %> points under the <%= fmt(score.cap) %> cap.<% } %>
        Sum of <%= score.counted %> regular players' final ratings<%= score.unrated ? ` (${score.unrated} unrated count as 0)` : '' %>; subs aren't counted.</span>
    </div>
  </div>
  <div class="table-wrap">
  <table class="table">
    <thead><tr><th>#</th><th>Jersey</th><th>Player name</th><th class="num">Final rating 0–<%= levels.MAX_POINTS %></th><th>GURHA level</th><th class="num">Raters</th></tr></thead>
    <tbody>
      <% players.forEach(function (p, i) { const s = summaries.get(p.id); %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= p.team_jersey || '' %></td>
          <td><a href="/players/<%= p.id %>"><%= p.first_name %> <%= p.last_name %></a><% if (p.team_is_sub) { %> <span class="tag">Sub</span><% } %><% if (s.needsReview) { %> <span class="tag tag-warn">3rd review</span><% } %></td>
          <td class="num"><%= fmt(s.avgOverall) %></td>
          <td><%- include('../partials/level', { level: s.level }) %><%= s.overridden ? ' *' : '' %></td>
          <td class="num"><%= s.count %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <p class="small muted">* Final level set by an admin. Final rating is the average of all raters' points. Score is the sum of the regular players' final ratings. A player on several teams (e.g. as a sub) has one rating per season, shown on each team.</p>
  <h3>Individual GURHA rating scale</h3>
  <div class="scale">
    <% levels.BANDS.forEach(function (b) { %><div><%- include('../partials/level', { level: b.level }) %> <span class="muted small"><%= Object.entries(b.points).map(([st, pts]) => st ? `${levels.STEP_NAMES[st]} ${pts}` : pts).join(' · ') %></span></div><% }) %>
  </div>
</section>
<% } %>
<%- include('../partials/foot') %>
