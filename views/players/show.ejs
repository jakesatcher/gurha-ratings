<%- include('../partials/head') %>
<% const isAdmin = currentUser.role === 'admin'; const posName = { F: 'Forward', D: 'Defense', G: 'Goaltender' }; %>
<p class="crumbs"><a href="/players">Leagues</a><% if (player.team_id) { %> › <a href="/leagues/<%= player.division ? encodeURIComponent(player.division) : '_none' %>"><%= player.division || 'No league' %></a> › <a href="/teams/<%= player.team_id %>"><%= player.team %></a><% } %> › <%= player.first_name %> <%= player.last_name %></p>

<section class="card player-hero">
  <div class="hero-main">
    <div class="hero-jersey"><%= player.jersey_number ? '#' + player.jersey_number : '–' %></div>
    <div>
      <h1><%= player.first_name %> <%= player.last_name %>
        <% if (!player.active) { %><span class="tag">inactive</span><% } %></h1>
      <p class="muted"><%= [posName[player.position], ageOf(player) ? `Age ${ageOf(player)}` : null].filter(Boolean).join(' · ') %></p>
      <% if (player.memberships && player.memberships.length) { %>
        <ul class="team-chips"><% player.memberships.forEach(function (m) { %>
          <li><%= m.team || 'No team' %><%= m.division ? ` · ${m.division}` : '' %><%= m.jersey_number ? ` · #${m.jersey_number}` : '' %><% if (m.is_sub) { %> <span class="tag">Sub</span><% } %></li>
        <% }) %></ul>
      <% } %>
    </div>
  </div>
  <div class="hero-level">
    <%- include('../partials/level', { level: summary.level, big: true }) %>
    <div class="small muted">
      <% if (summary.overridden) { %>Admin-set level<% } else if (summary.count) { %>Avg score <strong><%= fmt(summary.avgOverall) %></strong> / <%= levels.MAX_POINTS %><% } else { %>No ratings yet<% } %>
    </div>
  </div>
</section>

<% if (!onRoster) { %>
  <div class="alert alert-info"><%= player.first_name %> isn't on the <strong><%= season ? season.name : '' %></strong> roster.<% if (isAdmin) { %> <a href="/admin/players/<%= player.id %>/edit">Add them to this season</a>.<% } %></div>
<% } else if (!season.ratings_open && currentUser.canRate) { %>
  <div class="alert alert-info">Ratings for <strong><%= season.name %></strong> are closed.</div>
<% } %>

<% if (summary.needsReview) { %>
  <div class="alert alert-warn">⚠️ Raters' levels differ by <%= summary.levelSpread %> levels. Per GURHA guidelines this player should be flagged for a <strong>third review</strong>.</div>
<% } %>

<div class="actions">
  <% if (myRating) { %>
    <span class="rated-mark">✓ You rated this player on <%= fmtDate(myRating.created_at) %></span>
  <% } else if (canRate) { %>
    <a class="btn btn-primary" href="/players/<%= player.id %>/rate">Rate this player</a>
  <% } %>
  <% if (isAdmin) { %>
    <a class="btn" href="/admin/players/<%= player.id %>/edit">Edit player</a>
  <% } %>
</div>

<section class="card">
  <h2><%= season ? season.name : '' %> ratings <span class="muted small">(<%= summary.count %> rating<%= summary.count === 1 ? '' : 's' %>)</span></h2>
  <% if (summary.disqualifiedCount) { %><p class="small muted"><%= summary.disqualifiedCount %> rating<%= summary.disqualifiedCount === 1 ? ' was' : 's were' %> disqualified by an admin and <%= summary.disqualifiedCount === 1 ? "isn't" : "aren't" %> counted.</p><% } %>
  <% if (summary.legacyCount) { %><p class="small muted"><%= summary.legacyCount %> older rating<%= summary.legacyCount === 1 ? ' uses' : 's use' %> the previous 0–11 scale and <%= summary.legacyCount === 1 ? "isn't" : "aren't" %> counted.<% if (isAdmin) { %> Edit to re-score on the new scale, or delete.<% } %></p><% } %>
  <% if (!summary.count) { %>
    <p class="muted">No ratings submitted yet.</p>
  <% } else { %>
    <div class="bars">
      <% categories.forEach(function (c) { const v = summary.categoryAverages[c.id]; %>
        <div class="bar-row">
          <div class="bar-label"><%= c.name %> <span class="muted small"><%= Number(c.weight) %>%</span></div>
          <div class="bar-track" aria-hidden="true"><div class="bar-fill" style="--pct: <%= v === null ? 0 : Math.round(v / levels.MAX_POINTS * 100) %>%"></div></div>
          <div class="bar-value"><%= fmt(v, 1) %> <%- include('../partials/level', { level: levels.levelForScore(v) }) %></div>
        </div>
      <% }) %>
    </div>
    <dl class="dl dl-inline">
      <dt>Weighted overall</dt><dd><strong><%= fmt(summary.avgOverall) %></strong> / <%= levels.MAX_POINTS %> → <%- include('../partials/level', { level: summary.calculatedLevel }) %></dd>
      <% if (summary.overridden) { %>
        <dt>Admin final level</dt><dd><%- include('../partials/level', { level: player.level_override }) %> <span class="muted small"><%= player.level_override_note || '' %></span></dd>
      <% } %>
    </dl>
  <% } %>
</section>

<% if (isAdmin && onRoster) { %>
<section class="card">
  <h2>Admin: <%= season.name %> final level override</h2>
  <form method="post" action="/admin/players/<%= player.id %>/override" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <select name="level_override" aria-label="Final level">
      <option value="">— Use calculated level —</option>
      <% levels.LEVELS.forEach(function (l) { %><option <%= player.level_override === l ? 'selected' : '' %>><%= l %></option><% }) %>
    </select>
    <input name="level_override_note" placeholder="Reason (optional)" value="<%= player.level_override_note || '' %>" maxlength="1000">
    <button class="btn" type="submit">Save</button>
  </form>
</section>
<% } %>

<% if (history.seasons.length) { %>
<section class="card">
  <h2>Season history</h2>
  <div class="table-wrap">
  <table class="table compact">
    <thead><tr><th>Season</th><th>Team</th><th class="num hide-sm">#</th><th class="num">Avg</th><th>Level</th><th class="num">+/−</th><th class="num hide-sm">Ratings</th></tr></thead>
    <tbody>
      <% history.seasons.forEach(function (h, i) {
           const prev = history.seasons.slice(i + 1).find(function (x) { return x.summary.avgOverall !== null; });
           const delta = prev && h.summary.avgOverall !== null ? h.summary.avgOverall - prev.summary.avgOverall : null; %>
        <tr class="<%= season && h.season_id === season.id ? 'current-row' : '' %>">
          <td><%= h.season_name %></td>
          <td><%= h.teams || '—' %></td>
          <td class="num hide-sm"><%= h.jersey_number || '' %></td>
          <td class="num"><%= fmt(h.summary.avgOverall) %></td>
          <td><%- include('../partials/level', { level: h.summary.count || h.summary.overridden ? h.summary.level : null }) %></td>
          <td class="num"><% if (delta === null) { %>—<% } else if (Math.abs(delta) < 0.005) { %>0.00<% } else { %><span class="<%= delta > 0 ? 'trend-up' : 'trend-down' %>"><%= delta > 0 ? '▲' : '▼' %> <%= Math.abs(delta).toFixed(2) %></span><% } %></td>
          <td class="num hide-sm"><%= h.summary.count %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
  <p class="small muted">Change compares the average score with the player's previous rated season.</p>
</section>
<% } %>

<section>
  <h2>Submitted ratings <span class="muted small">· <%= season ? season.name : '' %></span></h2>
  <% if (!ratings.length) { %><p class="muted">None yet.</p><% } %>
  <% ratings.forEach(function (r) { %>
    <details class="card rating-card" id="rating-<%= r.id %>" <%= r.rater_id === currentUser.id ? 'open' : '' %>>
      <summary>
        <span><strong><%= r.display_name %></strong><%= r.rater_id === currentUser.id ? ' (you)' : '' %>
          <% if (r.source === 'paper') { %><span class="tag" title="Entered from a paper form">paper<% if (currentUser.role === 'admin' && r.paper_form_id) { %> · <a href="/admin/paper/forms/<%= r.paper_form_id %>"><%= r.paper_form_code %></a><% } %></span><% } %>
          <span class="muted small">· <%= fmtDate(r.created_at) %><%= r.updated_by && r.updated_by !== r.rater_id ? ' · edited by admin' : '' %></span></span>
        <span class="rating-summary-levels">
          <% if (r.disqualified) { %><span class="tag tag-rejected">disqualified</span><% } %>
          <% if (r.legacy) { %><span class="tag">old 0–11 scale</span><% } else { %>
          <span class="small muted"><%= fmt(r.overall) %></span>
          <%- include('../partials/level', { level: r.calculated_level }) %><% } %>
        </span>
      </summary>
      <% if (r.disqualified) { %>
        <div class="alert alert-warn">Disqualified<%= isAdmin && r.disqualified_by_name ? ` by ${r.disqualified_by_name}` : '' %> on <%= fmtDate(r.disqualified_at) %>. Not counted toward averages.<% if (isAdmin) { %><br><strong>Reason:</strong> <%= r.disqualified_reason %><% } %></div>
      <% } %>
      <table class="table compact">
        <% const catNotes = r.scores.some(x => x.comment); %>
        <thead><tr><th>Category</th><th>Rating</th><th class="num">Points</th><% if (catNotes) { %><th>Comments</th><% } %></tr></thead>
        <tbody>
          <% categories.forEach(function (c) { const s = r.scoreMap[c.id]; %>
            <tr><td><%= c.name %></td>
              <td class="grade-tag"><% if (s && s.gradeInfo) { %><%- include('../partials/level', { level: s.gradeInfo.level }) %> <%= s.gradeInfo.step ? levels.STEP_NAMES[s.gradeInfo.step] : '' %><% } else { %>—<% } %></td>
              <td class="num"><%= s ? fmt(s.score, 1) : '—' %></td><% if (catNotes) { %><td><%= s && s.comment ? s.comment : '' %></td><% } %></tr>
          <% }) %>
        </tbody>
      </table>
      <dl class="dl">
        <% if (r.legacy) { %>
          <dt>Old 0–11 overall</dt><dd><%= fmt(r.overall) %> <span class="muted small">(not counted)</span></dd>
        <% } else { %>
          <dt>Calculated</dt><dd><%= fmt(r.overall) %> / <%= levels.MAX_POINTS %> → <%- include('../partials/level', { level: r.calculated_level }) %></dd>
        <% } %>
        <% if (r.legacy && r.final_level) { %><dt>Rater's level</dt><dd><%- include('../partials/level', { level: r.final_level }) %></dd><% } %>
        <% if (r.evidence) { %><dt>Comments</dt><dd class="pre"><%= r.evidence %></dd><% } %>
        <% if (r.legacy && r.strengths) { %><dt>Strengths</dt><dd class="pre"><%= r.strengths %></dd><% } %>
        <% if (r.legacy && r.improvements) { %><dt>To improve</dt><dd class="pre"><%= r.improvements %></dd><% } %>
      </dl>
      <% if (isAdmin) { %>
        <div class="actions">
          <a class="btn btn-small" href="/admin/ratings/<%= r.id %>/edit">Change rating</a>
          <form method="post" action="/admin/ratings/<%= r.id %>/delete" class="inline" data-confirm="Delete this rating? The rater will be able to submit a new one.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="btn btn-small btn-danger" type="submit">Delete</button>
          </form>
        </div>
        <% if (r.disqualified) { %>
          <form method="post" action="/admin/ratings/<%= r.id %>/reinstate" class="inline-form dq-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input name="reason" maxlength="1000" required placeholder="Reason for reinstating (required)" aria-label="Reason for reinstating">
            <button class="btn btn-small" type="submit">Reinstate</button>
          </form>
        <% } else { %>
          <form method="post" action="/admin/ratings/<%= r.id %>/disqualify" class="inline-form dq-form" data-confirm="Disqualify this rating? It stays on record but won't count toward the player's averages.">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input name="reason" maxlength="1000" required placeholder="Why is this rating unrealistic? (required)" aria-label="Reason for disqualifying">
            <button class="btn btn-small btn-danger" type="submit">Disqualify</button>
          </form>
        <% } %>
      <% } %>
    </details>
  <% }) %>
</section>
<%- include('../partials/foot') %>
