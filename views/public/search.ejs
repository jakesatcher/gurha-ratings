<%- include('../partials/head') %>
<section class="card public-hero">
  <h1>Player ratings</h1>
  <p class="muted"><%= publicSeason ? publicSeason.name : 'No season yet' %></p>
  <form method="get" action="/" role="search" class="public-search">
    <label for="q" class="sr-hidden">Player name</label>
    <input id="q" name="q" type="search" value="" maxlength="60" placeholder="Search by player name" autocomplete="off" autofocus>
    <button class="btn btn-primary" type="submit">Search</button>
  </form>
</section>

<% if (tooShort) { %>
  <p class="muted">Type at least 2 letters.</p>
<% } else if (results) { %>
  <% if (!results.length) { %>
    <div class="card"><p>No players found for “<%= q %>”.</p></div>
  <% } else { %>
    <p class="small muted">Results for “<%= q %>”</p>
    <ul class="player-list public-list">
      <% results.forEach(function (p) { %>
        <li class="player-row">
          <a class="player-link" href="/player/<%= p.id %>">
            <span class="player-main">
              <span class="player-name"><%= p.last_name %>, <%= p.first_name %></span>
              <span class="player-meta"><%- include('_teams', { teams: p.teams }) %></span>
            </span>
            <span class="player-score"><%- include('_rating', { r: p.rating }) %></span>
          </a>
        </li>
      <% }) %>
    </ul>
    <% if (results.length === 50) { %><p class="small muted">Showing the first 50 matches. Type more of the name to narrow it down.</p><% } %>
  <% } %>
<% } %>
<%- include('../partials/foot') %>
