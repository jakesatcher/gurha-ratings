<%- include('../partials/head') %>
<h1>Rating categories</h1>
<%- include('_nav') %>
<div class="alert <%= Math.abs(total - 100) > 0.001 ? 'alert-warn' : 'alert-info' %>">
  Active weights total <strong><%= total %>%</strong>. <% if (Math.abs(total - 100) > 0.001) { %>They should add up to 100%.<% } %>
  Changing weights recalculates every player's overall score.
</div>
<% const catForm = function (c) { const isNew = !c.id; %>
  <form method="post" action="<%= isNew ? '/admin/categories' : `/admin/categories/${c.id}` %>" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="grid-4">
      <label>Name <input name="name" value="<%= c.name || '' %>" required maxlength="100"></label>
      <label>Weight % <input name="weight" type="number" step="0.01" min="0" max="100" value="<%= c.weight !== undefined ? Number(c.weight) : '' %>" required></label>
      <label>Min score <input name="min_score" type="number" value="<%= c.min_score ?? 0 %>" required></label>
      <label>Max score <input name="max_score" type="number" value="<%= c.max_score ?? 11 %>" required></label>
    </div>
    <label>Key question <input name="key_question" value="<%= c.key_question || '' %>"></label>
    <label>Note <input name="note" value="<%= c.note || '' %>"></label>
    <label>What to consider <small class="muted">(one per line)</small>
      <textarea name="considerations" rows="4"><%= (c.considerations || []).join('\n') %></textarea></label>
    <label>Rating guide <small class="muted">(one per line: <code>range | label | description</code>)</small>
      <textarea name="guide" rows="4"><%= (c.guide || []).map(g => `${g.range} | ${g.label} | ${g.text}`).join('\n') %></textarea></label>
    <div class="grid-4">
      <label>Sort order <input name="sort_order" type="number" value="<%= c.sort_order || 0 %>"></label>
      <% if (!isNew) { %><label class="check"><input type="checkbox" name="active" <%= c.active ? 'checked' : '' %>> Active</label><% } %>
    </div>
    <button class="btn btn-primary" type="submit"><%= isNew ? 'Add category' : 'Save' %></button>
  </form>
<% } %>
<% categories.forEach(function (c) { %>
  <details class="card">
    <summary><strong><%= c.name %></strong> <span class="muted">· <%= Number(c.weight) %>% · <%= c.min_score %>–<%= c.max_score %></span><% if (!c.active) { %> <span class="tag">inactive</span><% } %></summary>
    <% catForm(c) %>
  </details>
<% }) %>
<details class="card">
  <summary><strong>+ Add a category</strong></summary>
  <% catForm({ min_score: 0, max_score: 11, weight: 0 }) %>
</details>
<%- include('../partials/foot') %>
