<%- include('../partials/head') %>
<h1>Import players</h1>
<%- include('_nav') %>
<div class="alert alert-info">CSV / JSON uploads go into <strong><%= season.name %></strong> (change it with the season selector at the top). SportsEngine exports let you pick the season during review.</div>

<% if (result) { %>
  <div class="alert alert-success" role="status">
    Import complete: <strong><%= result.created %></strong> created, <strong><%= result.updated %></strong> updated, <strong><%= result.skipped %></strong> skipped.
    <% if (result.errors.length) { %><ul class="small"><% result.errors.slice(0, 50).forEach(function (e) { %><li><%= e %></li><% }) %></ul><% } %>
    <p><a href="/admin/players">View players</a></p>
  </div>
<% } %>

<section class="card">
  <h2>SportsEngine roster export (.xls)</h2>
  <p>Upload the roster workbook exported from SportsEngine (one sheet per team). You'll review the teams and choose a season before anything is saved.</p>
  <form method="post" action="/admin/import/sportsengine" enctype="multipart/form-data" class="inline-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="file" name="file" accept=".xls,application/vnd.ms-excel" required aria-label="SportsEngine export file">
    <button class="btn btn-primary" type="submit">Upload &amp; review</button>
  </form>
  <details class="small">
    <summary>Expected format</summary>
    <p>Each sheet starts with <code>League</code>, <code>Division</code>, <code>Season</code> and <code>Team</code> rows (the team row includes the SportsEngine team ID), then a header row: <code>SportNgin ID</code>, <code>Jersey #</code>, <code>First Name</code>, <code>Last Name</code>, <code>Position</code>, <code>Date of Birth</code>, … Gender, height, weight and school columns are ignored.</p>
  </details>
</section>

<div class="grid-2">
  <section class="card">
    <h2>Upload CSV or JSON</h2>
    <form method="post" action="/admin/import" enctype="multipart/form-data" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="season_id" value="<%= season.id %>">
      <label>File <input type="file" name="file" accept=".csv,.json,text/csv,application/json"></label>
      <label>…or paste CSV / JSON <textarea name="pasted" rows="5" placeholder="first_name,last_name,jersey_number,team&#10;Wayne,Example,99,Blue Liners"></textarea></label>
      <button class="btn btn-primary" type="submit">Import</button>
    </form>
    <p class="small"><a href="/admin/import/template.csv">Download CSV template</a></p>
    <details class="small">
      <summary>Accepted columns</summary>
      <p><code>first_name</code>, <code>last_name</code> (or a single <code>name</code> column), <code>jersey_number</code>, <code>team</code>, <code>division</code>, <code>position</code> (F/D/G or Forward/Defense/Goalie), <code>age</code>, <code>email</code>, <code>external_id</code>, <code>notes</code>.</p>
      <p>JSON may be an array of player objects, or <code>{ "players": [ … ] }</code>.</p>
      <p>Existing players are matched by <code>external_id</code>, then name + team in this season, then email, then a unique first + last name. They're updated and added to this season's roster instead of being duplicated. Teams are created in this season as needed.</p>
    </details>
  </section>
  <section class="card">
    <h2>SportsEngine</h2>
    <% if (seConfigured) { %>
      <p>Pick a SportsEngine season and choose which teams to import.</p>
      <p><a class="btn btn-primary" href="/admin/sportsengine">Browse SportsEngine</a></p>
      <p class="small"><a href="/admin/sportsengine/diagnostics">Diagnostics (dry run)</a></p>
    <% } else { %>
      <p class="muted">Not configured. Set <code>SPORTSENGINE_CLIENT_ID</code>, <code>SPORTSENGINE_CLIENT_SECRET</code> and <code>SPORTSENGINE_ORG_ID</code> in Railway to enable roster import.</p>
    <% } %>
  </section>
</div>
<%- include('../partials/foot') %>
