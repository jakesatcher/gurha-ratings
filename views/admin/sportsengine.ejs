<%- include('../partials/head') %>
<h1>SportsEngine</h1>
<%- include('_nav') %>

<% if (step === 'off') { %>
  <div class="alert alert-warn">Not configured. Set <code>SPORTSENGINE_CLIENT_ID</code>, <code>SPORTSENGINE_CLIENT_SECRET</code> and <code>SPORTSENGINE_ORG_ID</code> in Railway.</div>

<% } else if (step === 'seasons') { %>
  <ol class="wizard"><li class="on">1. Season</li><li>2. Teams</li><li>3. Import</li></ol>
  <% if (error) { %>
    <div class="alert alert-error"><strong>Couldn't load seasons:</strong> <%= error %> <a href="/admin/sportsengine/diagnostics">Run diagnostics</a></div>
  <% } else if (!result.supported) { %>
    <div class="alert alert-info">Your SportsEngine API access doesn't expose seasons, so teams can't be split by season automatically. On the next page you can narrow the list by when teams were created and by division, then choose which GURHA season they go into.</div>
    <p><a class="btn btn-primary" href="/admin/sportsengine/teams">Browse teams</a></p>
  <% } else if (!result.seasons.length) { %>
    <div class="alert alert-info">SportsEngine returned no seasons for your organization. <a href="/admin/sportsengine/teams">Browse all teams</a> instead.</div>
  <% } else { %>
    <% const seLink = (s) => `/admin/sportsengine/teams?${new URLSearchParams({ season: s.id, name: s.name, start: s.start_date || '', end: s.end_date || '' })}`;
       const current = result.seasons.find(s => s.id === result.currentId); %>
    <% if (current) { %>
    <section class="card se-current">
      <h2>Current season</h2>
      <p><strong><%= current.name %></strong> <span class="muted small"><%= current.start_date ? fmtDate(current.start_date) : '' %><%= current.end_date ? ` – ${fmtDate(current.end_date)}` : '' %></span>
        <% if (linked.get(current.id)) { %><span class="tag tag-approved">Imported as “<%= linked.get(current.id).name %>”</span><% } %></p>
      <a class="btn btn-primary" href="<%= seLink(current) %>">Show <%= current.name %> teams</a>
    </section>
    <% } %>
    <section class="card">
      <h2><%= current ? 'Or choose another season' : 'Choose a SportsEngine season' %></h2>
      <ul class="list">
        <% result.seasons.forEach(function (s) { const l = linked.get(s.id); %>
          <li>
            <a href="<%= seLink(s) %>"><strong><%= s.name %></strong></a>
            <span class="muted small"><%= s.start_date ? fmtDate(s.start_date) : '' %><%= s.end_date ? ` – ${fmtDate(s.end_date)}` : '' %></span>
            <% if (s.id === result.currentId) { %><span class="tag tag-pending">Current</span><% } %>
            <% if (l) { %><span class="tag tag-approved">Imported as “<%= l.name %>”</span><% } %>
          </li>
        <% }) %>
      </ul>
      <p class="small"><a href="/admin/sportsengine/teams">Or browse all teams without a season filter</a></p>
    </section>
  <% } %>

<% } else if (step === 'teams') { %>
  <ol class="wizard"><li>1. Season</li><li class="on">2. Teams</li><li>3. Import</li></ol>
  <p class="crumbs"><a href="/admin/sportsengine">← Choose a different season</a></p>
  <% if (error) { %>
    <div class="alert alert-error"><strong>Couldn't load teams:</strong> <%= error %> <a href="/admin/sportsengine/diagnostics">Run diagnostics</a></div>
  <% } else { %>
    <% const unfiltered = result.filter === 'none'; %>
    <% if (seSeason.id && unfiltered) { %>
      <div class="alert alert-warn">SportsEngine doesn't say which season each team belongs to, so <strong>all teams</strong> are listed. Use the filters below to narrow them to <%= seSeason.name || 'this season' %>, and <a href="/admin/sportsengine/diagnostics">run diagnostics</a> to see what the API offers.</div>
    <% } else if (seSeason.id) { %>
      <p class="small muted">Showing only teams in <strong><%= seSeason.name %></strong>.</p>
    <% } %>
    <form method="post" action="/admin/sportsengine/import" class="stack" data-check-scope>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="se_season_id" value="<%= seSeason.id || '' %>">
      <input type="hidden" name="se_season_name" value="<%= seSeason.name || '' %>">
      <input type="hidden" name="se_start_date" value="<%= seSeason.start_date || '' %>">
      <input type="hidden" name="se_end_date" value="<%= seSeason.end_date || '' %>">
      <section class="card">
        <h2>Teams<%= seSeason.name ? ` in ${seSeason.name}` : '' %> <span class="muted small">(<%= result.teams.length %>)</span></h2>
        <% if (!result.teams.length) { %><p class="muted">No teams found.</p><% } else { %>
          <% if (unfiltered && result.teams.some(t => t.created || t.status)) {
               const statuses = [...new Set(result.teams.map(t => t.status).filter(Boolean))];
               // Default: teams created up to ~4 months before the season starts.
               let since = '';
               if (seSeason.start_date) { const d = new Date(seSeason.start_date); d.setMonth(d.getMonth() - 4); since = d.toISOString().slice(0, 10); } %>
            <div class="filter-row se-filters" data-team-filters>
              <% if (result.teams.some(t => t.created)) { %><label>Created on or after <input type="date" data-filter-created value="<%= since %>"></label><% } %>
              <% if (statuses.length > 1) { %><label>Status <select data-filter-status><option value="">Any</option><% statuses.forEach(function (st) { %><option <%= /^active$/i.test(st) ? 'selected' : '' %>><%= st %></option><% }) %></select></label><% } %>
              <span class="small muted" data-filter-count></span>
            </div>
          <% } %>
          <label class="check"><input type="checkbox" data-check-all="team_ids"> Select all<%= unfiltered ? ' shown' : '' %></label>
          <% const groups = new Map(); result.teams.forEach(function (t) { const k = t.division || (t.division_id ? `Division ${t.division_id}` : 'No division'); if (!groups.has(k)) groups.set(k, []); groups.get(k).push(t); }); %>
          <% groups.forEach(function (list, div) { %>
            <fieldset class="se-division" data-check-scope>
              <legend><label class="check"><input type="checkbox" data-check-all="team_ids"> <strong><%= div %></strong> <span class="small muted">(<%= list.length %>)</span></label></legend>
              <ul class="team-pick">
                <% list.forEach(function (t) { %>
                  <li data-team data-created="<%= t.created ? String(t.created).slice(0, 10) : '' %>" data-status="<%= t.status || '' %>"><label><input type="checkbox" name="team_ids" value="<%= t.id %>"> <%= t.name %>
                    <span class="small muted"><%= [t.created ? `created ${fmtDate(String(t.created).slice(0, 10))}` : null, t.status && unfiltered ? t.status : null, imported.has(t.id) ? 'imported' : null].filter(Boolean).join(' · ') %></span></label></li>
                <% }) %>
              </ul>
            </fieldset>
          <% }) %>
        <% } %>
      </section>
      <section class="card">
        <h2>Import into</h2>
        <% const defaultNew = !linked; %>
        <label class="check"><input type="radio" name="target" value="new" <%= defaultNew ? 'checked' : '' %>> New GURHA season</label>
        <div class="grid-2">
          <label>Season name <input name="new_season_name" value="<%= seSeason.name || '' %>" maxlength="100"></label>
          <label class="check"><input type="checkbox" name="make_current"> Make it the current season</label>
        </div>
        <% localSeasons.forEach(function (s) { %>
          <label class="check"><input type="radio" name="target" value="<%= s.id %>" <%= linked && linked.id === s.id ? 'checked' : '' %>> <%= s.name %><%= s.is_current ? ' (current)' : '' %><%= linked && linked.id === s.id ? ' — linked to this SportsEngine season' : '' %></label>
        <% }) %>
        <p class="small muted">Players are matched to existing GURHA players (by SportsEngine ID, then name), so ratings history carries across seasons. Nobody is deleted.</p>
      </section>
      <% if (result.teams.length) { %><button class="btn btn-primary" type="submit">Import selected teams</button><% } %>
    </form>
  <% } %>

<% } else if (step === 'done') { %>
  <ol class="wizard"><li>1. Season</li><li>2. Teams</li><li class="on">3. Import</li></ol>
  <div class="alert alert-success" role="status">
    Imported <strong><%= teamCount %></strong> team<%= teamCount === 1 ? '' : 's' %> into <strong><%= importSeason.name %></strong>:
    <strong><%= importResult.created %></strong> new players, <strong><%= importResult.updated %></strong> existing players updated, <strong><%= importResult.skipped %></strong> skipped.
    <% if (importResult.errors.length) { %><ul class="small"><% importResult.errors.slice(0, 50).forEach(function (e) { %><li><%= e %></li><% }) %></ul><% } %>
  </div>
  <p class="actions">
    <a class="btn btn-primary" href="/players">View <%= importSeason.name %> players</a>
    <a class="btn" href="/admin/seasons/<%= importSeason.id %>">Season settings</a>
    <a class="btn" href="/admin/sportsengine">Import more</a>
  </p>
<% } %>

<p class="small muted"><a href="/admin/sportsengine/diagnostics">Diagnostics (dry run)</a></p>
<%- include('../partials/foot') %>
