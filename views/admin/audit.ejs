<%- include('../partials/head') %>
<h1>Audit log</h1>
<%- include('_nav') %>
<div class="table-wrap">
<table class="table compact">
  <thead><tr><th>When</th><th>Who</th><th>Action</th><th>Target</th><th>Details</th></tr></thead>
  <tbody>
  <% entries.forEach(function (e) { %>
    <tr>
      <td class="nowrap"><%= new Date(e.created_at).toLocaleString('en-US', { timeZone: tz }) %></td>
      <td><%= e.actor_name || '—' %></td>
      <td><%= e.action.replace(/_/g, ' ') %></td>
      <td><% if (e.entity === 'player' && e.entity_id) { %><a href="/players/<%= e.entity_id %>">player <%= e.entity_id %></a><% } else if (e.entity === 'rating' && e.details && e.details.player_id) { %><a href="/players/<%= e.details.player_id %>#rating-<%= e.entity_id %>">rating <%= e.entity_id %></a><% } else { %><%= e.entity || '' %> <%= e.entity_id || '' %><% } %></td>
      <td><code class="small wrap"><%= e.details ? JSON.stringify(e.details) : '' %></code></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<%- include('../partials/foot') %>
