<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#0b1f3a">
  <title><%= title ? `${title} · ${appName}` : appName %></title>
  <link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/static/fonts/oswald-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/app.css">
  <script src="/static/js/password-policy.js" defer></script>
  <script src="/static/js/app.js" defer></script>
</head>
<body>
<div class="rink-bg" aria-hidden="true"></div>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/"><span class="brand-puck" aria-hidden="true"></span><span class="brand-text">GURHA</span> <span class="brand-sub">Ratings</span></a>
    <% if (currentUser) { %>
    <nav class="nav" aria-label="Main">
      <a href="/players" class="<%= path.startsWith('/players') ? 'active' : '' %>">Players</a>
      <a href="/reports/teams" class="<%= path.startsWith('/reports') ? 'active' : '' %>">Teams</a>
      <% if (currentUser.role === 'admin') { %>
        <a href="/admin" class="<%= path.startsWith('/admin') ? 'active' : '' %>">Admin</a>
      <% } %>
      <a href="/account" class="<%= path.startsWith('/account') ? 'active' : '' %>">Account</a>
      <form method="post" action="/logout" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="linklike">Sign out</button>
      </form>
    </nav>
    <% } %>
  </div>
</header>
<% if (currentUser && seasons.length) { %>
<div class="seasonbar">
  <form method="post" action="/season" class="seasonbar-inner">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="return_to" value="<%= url %>">
    <label for="season-select">Season</label>
    <select id="season-select" name="season_id" data-autosubmit>
      <% seasons.forEach(function (s) { %>
        <option value="<%= s.id %>" <%= season && season.id === s.id ? 'selected' : '' %>><%= s.name %><%= s.is_current ? ' (current)' : '' %></option>
      <% }) %>
    </select>
    <noscript><button class="btn btn-small" type="submit">View</button></noscript>
    <% if (season && !season.ratings_open) { %><span class="tag tag-warn">Ratings closed</span><% } %>
    <% if (season && !season.is_current) { %><span class="tag">Past / other season</span><% } %>
  </form>
</div>
<% } %>
<%- include('ad', { slot: 'boards' }) %>
<main class="container">
<%- include('flash') %>
