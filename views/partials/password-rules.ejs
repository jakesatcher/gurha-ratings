<%# Password requirements checklist; app.js ticks items off live as the user types into [data-password-input]. %>
<div class="pw-rules" data-password-rules aria-live="polite">
  <p class="pw-rules-title">Password requirements</p>
  <ul>
    <% passwordPolicy.RULES.forEach(function (r) { %>
      <li data-rule="<%= r.id %>"><span class="pw-icon" aria-hidden="true"></span><span><%= r.label %></span></li>
    <% }) %>
    <li data-rule="match"><span class="pw-icon" aria-hidden="true"></span><span>Both passwords match</span></li>
  </ul>
</div>
