# --- Required in production ---
NODE_ENV=production
# Railway: reference your Postgres service, e.g. ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://user:pass@host:5432/railway
# Long random string (e.g. `openssl rand -base64 48`). Changing it signs everyone out.
SESSION_SECRET=
# Encrypts authenticator-app secrets at rest. Set once and never change it,
# or users will need their 2-step verification reset. Defaults to SESSION_SECRET.
ENCRYPTION_KEY=
APP_URL=https://robertmagnusmissesthe.net

# --- First admin (created on first boot if the email doesn't exist yet) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-something-long
ADMIN_NAME=GURHA Admin

# --- Email (needed for email codes, approvals and password resets) ---
# Option A (recommended on Railway): Resend HTTP API — https://resend.com
# The key needs "Sending access" for a domain verified in Resend (robertmagnusmissesthe.net).
RESEND_API_KEY=
# Optional: where replies go (e.g. the commissioner's inbox)
MAIL_REPLY_TO=
# Optional: signing secret of a Resend webhook pointed at https://robertmagnusmissesthe.net/webhooks/resend
RESEND_WEBHOOK_SECRET=
# Option B: SMTP (note: Railway blocks outbound SMTP on Free/Trial plans)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GURHA Ratings <ratings@robertmagnusmissesthe.net>

# --- Privacy ---
# When false (default), raters see other raters as "Rater 1", "Rater 2". Admins always see names.
SHOW_RATER_NAMES_TO_RATERS=false

# --- SportsEngine roster sync (optional) ---
SPORTSENGINE_CLIENT_ID=
SPORTSENGINE_CLIENT_SECRET=
SPORTSENGINE_ORG_ID=
SPORTSENGINE_SEASON_ID=
# Override if your SportsEngine developer docs specify different endpoints/query:
# SPORTSENGINE_TOKEN_URL=https://user.sportsengine.com/oauth/token
# SPORTSENGINE_GRAPHQL_URL=https://api.sportsengine.com/graphql
# SPORTSENGINE_ROSTER_QUERY=

# --- Look and feel ---
# Fictional rink-board sponsor ads (set to false to hide them)
ADS_ENABLED=true
# Time zone for displayed dates
TIME_ZONE=America/New_York
